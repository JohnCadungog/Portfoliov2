{
  "world": "swatch-fan-deck",
  "color": {
    "ink": { "engineer": "#2B3BE5", "design": "#D4006E", "automation": "#C6E400" },
    "onInk": { "engineer": "#FFFFFF", "design": "#FFFFFF", "automation": "#11140A" },
    "paper": "#F2F3F0", "paper2": "#E7E8E4", "strip": "#FBFBF9",
    "text": "#15161A", "text2": "#4C4F57", "line": "rgba(21,22,26,0.12)"
